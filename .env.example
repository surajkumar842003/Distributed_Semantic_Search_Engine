# Cache and Storage Paths (CRITICAL: Must point to /DATA/ to avoid filling root partition)
# =============================================================================
# Distributed Wikipedia Semantic Search & Grounded RAG Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Host Paths & Storage
# CRITICAL: Point DATA_DIR and CACHE_DIR to high-capacity NVMe mount (e.g. /DATA/)
# to avoid exhausting the OS root partition during large-scale ingestion.
# -----------------------------------------------------------------------------
DATA_DIR=/DATA/suraj/m1/search_engine/data
CACHE_DIR=/DATA/suraj/m1/search_engine/data/cache
HF_HOME=/DATA/suraj/m1/search_engine/data/cache/huggingface
TORCH_HOME=/DATA/suraj/m1/search_engine/data/cache/torch

# Staging in Shared Memory
SHM_DIR=/dev/shm/search_engine_staging

# Database Credentials
# -----------------------------------------------------------------------------
# 2. Database Credentials (PostgreSQL 16)
# Used by postgres service and application connection pools.
# Change POSTGRES_PASSWORD in production!
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=wikirag
POSTGRES_HOST=localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Model Inference Configuration
# -----------------------------------------------------------------------------
# 3. Redis Cache (Optional)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# 4. Hardware & GPU Acceleration
# NVIDIA L4 (24 GB VRAM) allocation:
# - Set CUDA_VISIBLE_DEVICES to select GPU ID (0 or 1 on dual-GPU hosts)
# - Container deploy sections reserve GPU via NVIDIA Container Toolkit
# -----------------------------------------------------------------------------
CUDA_VISIBLE_DEVICES=0
EMBEDDING_DEVICE=cuda:0
RERANK_DEVICE=cuda:0
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
CUDA_VISIBLE_DEVICES=0

# API Service
# -----------------------------------------------------------------------------
# 5. Ingestion Worker Configuration
# -----------------------------------------------------------------------------
NUM_CPU_WORKERS=8
WORKER_CHUNKSIZE=500
INGESTION_WATCH_INTERVAL=10
RAW_INPUT_DIR=/DATA/suraj/m1/search_engine/data/raw
CHUNKS_OUTPUT_DIR=/DATA/suraj/m1/search_engine/data/chunks

# -----------------------------------------------------------------------------
# 6. Embedding Service Configuration
# -----------------------------------------------------------------------------
EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=8001
EMBEDDING_SERVICE_URL=http://embedding-service:8001
EMBEDDING_BATCH_SIZE=64
AUTO_EMBED_SHARDS=false
EMBEDDINGS_OUTPUT_DIR=/DATA/suraj/m1/search_engine/data/embeddings

# -----------------------------------------------------------------------------
# 7. FastAPI Serving Service
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# LLM API (for RAG synthesis)
# -----------------------------------------------------------------------------
# 8. External LLM Synthesis (RAG Generator)
# Set your Gemini / OpenAI API key here. Never commit real keys to Git.
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TEMPERATURE=0.2

# -----------------------------------------------------------------------------
# 9. Monitoring & Observability (Prometheus & Grafana)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password
