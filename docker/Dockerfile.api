# FastAPI Serving Container for Distributed Wikipedia Semantic Search Engine & RAG
FROM python:3.10-slim
# =============================================================================
# FastAPI Serving Service Dockerfile
# Multi-stage build for high-speed semantic retrieval and RAG synthesis
# =============================================================================
FROM python:3.10-slim AS base

WORKDIR /app

# System dependencies
# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency specifications
COPY requirements.txt pyproject.toml /app/
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir fastapi uvicorn httpx pydantic asyncpg
# Install locked Python dependencies for reproducible builds
COPY requirements-lock.txt pyproject.toml /app/
RUN pip install --no-cache-dir -U pip setuptools wheel && \
    pip install --no-cache-dir -r requirements-lock.txt && \
    pip install --no-cache-dir -e .

# Copy application source and configuration
COPY src/ /app/src/
COPY configs/ /app/configs/
COPY migrations/ /app/migrations/

ENV PYTHONPATH=/app
ENV DATA_DIR=/DATA/suraj/m1/search_engine/data
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    DATA_DIR=/data \
    HF_HOME=/data/cache/huggingface \
    TORCH_HOME=/data/cache/torch

EXPOSE 8000

# Security: run as non-root user
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser
USER appuser

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.serving.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]

